<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SkimDownForWindows.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewer="using:SkimDownForWindows.Viewer"
    xmlns:models="using:SkimDownForWindows.Application.Models"
    AllowDrop="True"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- (Reserved for future styles) -->
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Menu bar -->
        <MenuBar Grid.Row="0">
            <MenuBarItem x:Uid="FileMenuBarItem">
                <MenuFlyoutItem x:Uid="OpenFolderMenuItem" Click="OnOpenFolderClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="O" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSubItem x:Name="RecentFoldersMenu" x:Uid="OpenRecentMenuItem" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="RevealInExplorerMenuItem"
                                Command="{x:Bind ViewModel.RevealInFileExplorerCommand}" />
                <MenuFlyoutItem x:Uid="CopyFilePathMenuItem"
                                Command="{x:Bind ViewModel.CopyFilePathCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="CloseWindowMenuItem" Click="OnCloseWindowClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="W" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>

            <MenuBarItem x:Uid="EditMenuBarItem">
                <MenuFlyoutItem x:Uid="CopyMenuItem" Click="OnCopyClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="C" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="SelectAllMenuItem" Click="OnSelectAllClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="A" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="FindMenuItem" Click="OnFindClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="F" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="FindNextMenuItem" Click="OnFindNextClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="G" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="FindPreviousMenuItem" Click="OnFindPrevClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="G" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="UseSelectionForFindMenuItem" Click="OnUseSelectionForFindClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="E" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>

            <MenuBarItem x:Uid="ViewMenuBarItem">
                <MenuFlyoutItem x:Name="ToggleSidebarMenuItem"
                                x:Uid="ToggleSidebarMenuItem"
                                IsEnabled="{x:Bind IsNotSingleFileMode(ViewModel.IsSingleFileMode), Mode=OneWay}"
                                Click="OnToggleSidebarClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="B" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="MoveSidebarMenuItem"
                                x:Uid="MoveSidebarMenuItem"
                                IsEnabled="{x:Bind IsNotSingleFileMode(ViewModel.IsSingleFileMode), Mode=OneWay}"
                                Click="OnMoveSidebarClick" />
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem x:Uid="ZoomMenuItem">
                    <MenuFlyoutItem x:Uid="ZoomInMenuItem" Click="OnZoomInClick">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="Add" />
                            <KeyboardAccelerator Modifiers="Control" Key="Number0" IsEnabled="False" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Uid="ZoomOutMenuItem" Click="OnZoomOutClick">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="Subtract" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Uid="ActualSizeMenuItem" Click="OnZoomResetClick">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="Number0" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem x:Name="ContentWidthSubmenu"
                                   x:Uid="ContentWidthMenuItem">
                    <ToggleMenuFlyoutItem x:Name="ContentWidthStandardMenu"
                                          x:Uid="ContentWidthStandardMenuItem"
                                          Click="OnContentWidthStandardClick" />
                    <ToggleMenuFlyoutItem x:Name="ContentWidthWideMenu"
                                          x:Uid="ContentWidthWideMenuItem"
                                          Click="OnContentWidthWideClick" />
                    <ToggleMenuFlyoutItem x:Name="ContentWidthExtraWideMenu"
                                          x:Uid="ContentWidthExtraWideMenuItem"
                                          Click="OnContentWidthExtraWideClick" />
                    <ToggleMenuFlyoutItem x:Name="ContentWidthFullMenu"
                                          x:Uid="ContentWidthFullMenuItem"
                                          Click="OnContentWidthFullClick" />
                    <!-- Ctrl+] / Ctrl+[ で隣接段階を切り替えるショートカットも併設するが、
                         WinUI の KeyboardAccelerator は `[` / `]` 用の VirtualKey 名を持たない
                         (VK_OEM_4 / VK_OEM_6 は数値のみ) ため、メニューには表示しない。
                         入力ハンドリングは OnPageKeyDown (WinUI フォーカス時) と
                         renderer.js の shortcutIdFromEvent (WebView2 フォーカス時) が担う。 -->
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem x:Name="ThemeSubmenu"
                                  x:Uid="ThemeMenuItem">
                    <ToggleMenuFlyoutItem x:Name="ThemeSystemMenu" x:Uid="ThemeSystemMenuItem" Click="OnThemeSystemClick" />
                    <ToggleMenuFlyoutItem x:Name="ThemeLightMenu" x:Uid="ThemeLightMenuItem" Click="OnThemeLightClick" />
                    <ToggleMenuFlyoutItem x:Name="ThemeDarkMenu" x:Uid="ThemeDarkMenuItem" Click="OnThemeDarkClick" />
                    <MenuFlyoutSeparator x:Name="ThemeBuiltInSeparator" />
                    <!-- Custom themes are inserted between ThemeBuiltInSeparator and ThemeActionSeparator at runtime. -->
                    <MenuFlyoutSeparator x:Name="ThemeActionSeparator" />
                    <MenuFlyoutItem x:Name="OpenThemesFolderMenu" x:Uid="OpenThemesFolderMenuItem" Click="OnOpenThemesFolderClick" />
                    <MenuFlyoutItem x:Name="ReloadThemesMenu" x:Uid="ReloadThemesMenuItem" Click="OnReloadThemesClick" />
                </MenuFlyoutSubItem>
            </MenuBarItem>

            <MenuBarItem x:Name="WindowMenu" x:Uid="WindowMenuBarItem">
                <MenuFlyoutItem x:Uid="NewWindowMenuItem" Click="OnNewWindowClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="N" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="MinimizeMenuItem" Click="OnMinimizeClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="M" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="ZoomWindowMenuItem" Click="OnWindowZoomClick" />
                <MenuFlyoutItem x:Uid="BringAllToFrontMenuItem" Click="OnBringAllToFrontClick" />
                <MenuFlyoutSeparator x:Name="WindowMenuListSeparator" />
                <!-- Dynamic list of open windows is appended below the separator at runtime. -->
            </MenuBarItem>

            <MenuBarItem x:Uid="HelpMenuBarItem">
                <MenuFlyoutItem x:Uid="AboutSkimDownMenuItem" Click="OnAboutClick" />
            </MenuBarItem>
        </MenuBar>

        <!-- Search bar: toggled by Ctrl+F -->
        <Border x:Name="SearchBar"
                Grid.Row="1"
                Visibility="Collapsed"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE721;" FontSize="14" Opacity="0.6" />
                <TextBox x:Name="SearchBox"
                         x:Uid="SearchBox"
                         PlaceholderText="Find in document"
                         Width="320"
                         TextChanged="OnSearchTextChanged"
                         KeyDown="OnSearchKeyDown" />
                <CheckBox x:Name="SearchCaseSensitive"
                          x:Uid="SearchCaseSensitive"
                          Content="Aa"
                          ToolTipService.ToolTip="Match case"
                          Checked="OnCaseToggleChanged"
                          Unchecked="OnCaseToggleChanged" />
                <Button x:Uid="SearchPreviousButton"
                        Content="&#xE0E2;"
                        FontFamily="Segoe Fluent Icons"
                        Click="OnFindPrevClick"
                        ToolTipService.ToolTip="Previous (Shift+Enter)"
                        AutomationProperties.Name="Previous result" />
                <Button x:Uid="SearchNextButton"
                        Content="&#xE0E3;"
                        FontFamily="Segoe Fluent Icons"
                        Click="OnFindNextClick"
                        ToolTipService.ToolTip="Next (Enter)"
                        AutomationProperties.Name="Next result" />
                <TextBlock x:Name="SearchStatus" VerticalAlignment="Center" Opacity="0.7" />
                <Button x:Uid="SearchCloseButton"
                        Content="&#xE10A;"
                        FontFamily="Segoe Fluent Icons"
                        Click="OnCloseSearchClick"
                        ToolTipService.ToolTip="Close (Esc)"
                        AutomationProperties.Name="Close search" />
            </StackPanel>
        </Border>

        <!-- Body. Left/right columns are populated dynamically by the
             OnLoaded handler based on the persisted SidebarPosition. -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="280" />
                <ColumnDefinition x:Name="SplitterColumn" Width="Auto" />
                <ColumnDefinition x:Name="RightColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Grid x:Name="Sidebar" Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.OpenedFolderName, Mode=OneWay}"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="MarkdownCountText"
                                   Opacity="0.65"
                                   Style="{ThemeResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <ScrollViewer Grid.Row="1" Padding="4">
                    <TreeView x:Name="Tree"
                              ItemsSource="{x:Bind ViewModel.RootItems, Mode=OneWay}"
                              ItemInvoked="OnTreeItemInvoked"
                              SelectionMode="Single">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="models:MarkdownTreeItem">
                                <TreeViewItem
                                    IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                    ItemsSource="{x:Bind Children}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="Segoe Fluent Icons"
                                                  Glyph="{x:Bind Glyph}"
                                                  FontSize="14" Opacity="0.75" />
                                        <TextBlock Text="{x:Bind Name}" />
                                    </StackPanel>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </ScrollViewer>
            </Grid>

            <!-- Splitter: drag to resize the active sidebar column. -->
            <Border x:Name="SidebarSplitter"
                    Grid.Column="1"
                    Width="6"
                    Background="Transparent"
                    ManipulationMode="TranslateX"
                    PointerEntered="OnSplitterPointerEntered"
                    PointerExited="OnSplitterPointerExited"
                    PointerPressed="OnSplitterPointerPressed"
                    PointerMoved="OnSplitterPointerMoved"
                    PointerReleased="OnSplitterPointerReleased"
                    PointerCanceled="OnSplitterPointerReleased"
                    PointerCaptureLost="OnSplitterPointerReleased" />

            <!-- Content area -->
            <Grid x:Name="ContentArea" Grid.Column="2">
                <!-- Markdown preview (always present so WebView2 can initialize) -->
                <viewer:MarkdownPreview x:Name="Preview" />

                <!-- Empty state: no folder. Overlays preview with a SOLID
                     opaque background so the WebView2's default surface
                     doesn't bleed through (LayerFillColorDefaultBrush is
                     semi-transparent in dark mode). -->
                <Border x:Name="EmptyState"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="20">
                        <Image Source="ms-appx:///Assets/AppIcon.png"
                               Width="120" Height="120"
                               HorizontalAlignment="Center"
                               Opacity="0.95" />
                        <TextBlock x:Uid="EmptyStateTitle"
                                   Style="{ThemeResource TitleLargeTextBlockStyle}"
                                   HorizontalAlignment="Center"
                                   Opacity="0.8" />
                        <TextBlock x:Uid="EmptyStateDescription"
                                   HorizontalAlignment="Center"
                                   Opacity="0.7" />
                        <Button x:Uid="EmptyStateOpenFolderButton"
                                HorizontalAlignment="Center"
                                Click="OnOpenFolderClick"
                                Style="{ThemeResource AccentButtonStyle}" />
                    </StackPanel>
                </Border>

                <!-- No markdown state: folder has no .md. Overlays preview with solid background. -->
                <Border x:Name="NoMarkdownState"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12">
                        <TextBlock x:Uid="NoMarkdownTitle"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                   HorizontalAlignment="Center"
                                   Opacity="0.8" />
                        <Button x:Uid="NoMarkdownOpenAnotherFolderButton"
                                HorizontalAlignment="Center"
                                Click="OnOpenFolderClick" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>

