<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SkimDownForWindows.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewer="using:SkimDownForWindows.Viewer"
    xmlns:models="using:SkimDownForWindows.Application.Models"
    AllowDrop="True"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- (Reserved for future styles) -->
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Menu bar -->
        <MenuBar Grid.Row="0">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="Open Folder…" Click="OnOpenFolderClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="O" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSubItem x:Name="RecentFoldersMenu" Text="Open Recent" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Reveal in File Explorer"
                                Command="{x:Bind ViewModel.RevealInFileExplorerCommand}" />
                <MenuFlyoutItem Text="Copy File Path"
                                Command="{x:Bind ViewModel.CopyFilePathCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Close Window" Click="OnCloseWindowClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="W" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>

            <MenuBarItem Title="Edit">
                <MenuFlyoutItem Text="Copy" Click="OnCopyClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="C" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Select All" Click="OnSelectAllClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="A" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Find…" Click="OnFindClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="F" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Find Next" Click="OnFindNextClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="G" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Find Previous" Click="OnFindPrevClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="G" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Use Selection for Find" Click="OnUseSelectionForFindClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="E" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>

            <MenuBarItem Title="View">
                <MenuFlyoutItem x:Name="ToggleSidebarMenuItem"
                                Text="Toggle Sidebar"
                                IsEnabled="{x:Bind IsNotSingleFileMode(ViewModel.IsSingleFileMode), Mode=OneWay}"
                                Click="OnToggleSidebarClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="B" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="MoveSidebarMenuItem"
                                Text="Move Sidebar to Right"
                                IsEnabled="{x:Bind IsNotSingleFileMode(ViewModel.IsSingleFileMode), Mode=OneWay}"
                                Click="OnMoveSidebarClick" />
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem Text="Zoom">
                    <MenuFlyoutItem Text="Zoom In" Click="OnZoomInClick">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="Add" />
                            <KeyboardAccelerator Modifiers="Control" Key="Number0" IsEnabled="False" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Zoom Out" Click="OnZoomOutClick">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="Subtract" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Actual Size" Click="OnZoomResetClick">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="Number0" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem x:Name="ThemeSubmenu"
                                  Text="Theme">
                    <ToggleMenuFlyoutItem x:Name="ThemeSystemMenu" Text="System" Click="OnThemeSystemClick" />
                    <ToggleMenuFlyoutItem x:Name="ThemeLightMenu"  Text="Light"  Click="OnThemeLightClick" />
                    <ToggleMenuFlyoutItem x:Name="ThemeDarkMenu"   Text="Dark"   Click="OnThemeDarkClick" />
                    <MenuFlyoutSeparator x:Name="ThemeBuiltInSeparator" />
                    <!-- Custom themes are inserted between ThemeBuiltInSeparator and ThemeActionSeparator at runtime. -->
                    <MenuFlyoutSeparator x:Name="ThemeActionSeparator" />
                    <MenuFlyoutItem x:Name="OpenThemesFolderMenu" Text="Open Themes Folder" Click="OnOpenThemesFolderClick" />
                    <MenuFlyoutItem x:Name="ReloadThemesMenu"     Text="Reload Themes"      Click="OnReloadThemesClick" />
                </MenuFlyoutSubItem>
            </MenuBarItem>

            <MenuBarItem x:Name="WindowMenu" Title="Window">
                <MenuFlyoutItem Text="New Window" Click="OnNewWindowClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="N" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Minimize" Click="OnMinimizeClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="M" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Zoom" Click="OnWindowZoomClick" />
                <MenuFlyoutItem Text="Bring All to Front" Click="OnBringAllToFrontClick" />
                <MenuFlyoutSeparator x:Name="WindowMenuListSeparator" />
                <!-- Dynamic list of open windows is appended below the separator at runtime. -->
            </MenuBarItem>

            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="About SkimDown" Click="OnAboutClick" />
            </MenuBarItem>
        </MenuBar>

        <!-- Search bar: toggled by Ctrl+F -->
        <Border x:Name="SearchBar"
                Grid.Row="1"
                Visibility="Collapsed"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE721;" FontSize="14" Opacity="0.6" />
                <TextBox x:Name="SearchBox"
                         PlaceholderText="Find in document"
                         Width="320"
                         TextChanged="OnSearchTextChanged"
                         KeyDown="OnSearchKeyDown" />
                <CheckBox x:Name="SearchCaseSensitive"
                          Content="Aa"
                          ToolTipService.ToolTip="Match case"
                          Checked="OnCaseToggleChanged"
                          Unchecked="OnCaseToggleChanged" />
                <Button Content="&#xE0E2;" FontFamily="Segoe Fluent Icons" Click="OnFindPrevClick" ToolTipService.ToolTip="Previous (Shift+Enter)" />
                <Button Content="&#xE0E3;" FontFamily="Segoe Fluent Icons" Click="OnFindNextClick" ToolTipService.ToolTip="Next (Enter)" />
                <TextBlock x:Name="SearchStatus" VerticalAlignment="Center" Opacity="0.7" />
                <Button Content="&#xE10A;" FontFamily="Segoe Fluent Icons" Click="OnCloseSearchClick" ToolTipService.ToolTip="Close (Esc)" />
            </StackPanel>
        </Border>

        <!-- Body. Left/right columns are populated dynamically by the
             OnLoaded handler based on the persisted SidebarPosition. -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="280" />
                <ColumnDefinition x:Name="SplitterColumn" Width="Auto" />
                <ColumnDefinition x:Name="RightColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Grid x:Name="Sidebar" Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.OpenedFolderName, Mode=OneWay}"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="MarkdownCountText"
                                   Opacity="0.65"
                                   FontSize="12" />
                    </StackPanel>
                </Border>
                <ScrollViewer Grid.Row="1" Padding="4">
                    <TreeView x:Name="Tree"
                              ItemsSource="{x:Bind ViewModel.RootItems, Mode=OneWay}"
                              ItemInvoked="OnTreeItemInvoked"
                              SelectionMode="Single">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="models:MarkdownTreeItem">
                                <TreeViewItem
                                    IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                    ItemsSource="{x:Bind Children}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="Segoe Fluent Icons"
                                                  Glyph="{x:Bind Glyph}"
                                                  FontSize="14" Opacity="0.75" />
                                        <TextBlock Text="{x:Bind Name}" />
                                    </StackPanel>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </ScrollViewer>
            </Grid>

            <!-- Splitter: drag to resize the active sidebar column. -->
            <Border x:Name="SidebarSplitter"
                    Grid.Column="1"
                    Width="6"
                    Background="Transparent"
                    ManipulationMode="TranslateX"
                    PointerEntered="OnSplitterPointerEntered"
                    PointerExited="OnSplitterPointerExited"
                    PointerPressed="OnSplitterPointerPressed"
                    PointerMoved="OnSplitterPointerMoved"
                    PointerReleased="OnSplitterPointerReleased"
                    PointerCanceled="OnSplitterPointerReleased"
                    PointerCaptureLost="OnSplitterPointerReleased" />

            <!-- Content area -->
            <Grid x:Name="ContentArea" Grid.Column="2">
                <!-- Markdown preview (always present so WebView2 can initialize) -->
                <viewer:MarkdownPreview x:Name="Preview" />

                <!-- Empty state: no folder. Overlays preview with a SOLID
                     opaque background so the WebView2's default surface
                     doesn't bleed through (LayerFillColorDefaultBrush is
                     semi-transparent in dark mode). -->
                <Border x:Name="EmptyState"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="20">
                        <Image Source="ms-appx:///Assets/AppIcon.png"
                               Width="120" Height="120"
                               HorizontalAlignment="Center"
                               Opacity="0.95" />
                        <TextBlock Text="SkimDown" Style="{ThemeResource TitleLargeTextBlockStyle}" HorizontalAlignment="Center" Opacity="0.8" />
                        <TextBlock Text="Open a folder to start reading."
                                   HorizontalAlignment="Center"
                                   Opacity="0.7" />
                        <Button Content="Open Folder…"
                                HorizontalAlignment="Center"
                                Click="OnOpenFolderClick"
                                Style="{ThemeResource AccentButtonStyle}" />
                    </StackPanel>
                </Border>

                <!-- No markdown state: folder has no .md. Overlays preview with solid background. -->
                <Border x:Name="NoMarkdownState"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12">
                        <TextBlock Text="No Markdown files found"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                   HorizontalAlignment="Center"
                                   Opacity="0.8" />
                        <Button Content="Open Another Folder…"
                                HorizontalAlignment="Center"
                                Click="OnOpenFolderClick" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>

